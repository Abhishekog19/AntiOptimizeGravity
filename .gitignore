# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── PyInstaller build artefacts ───────────────────────────────────────────────
dist/
build/
*.spec

# ── SQLite database and runtime data ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal
dashboard/data/

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
crash_log.txt

# ── Secrets / environment overrides ───────────────────────────────────────────
# Real .env files are never committed. Example/template files are intentionally
# tracked (config.example.env, *.example.env).
.env
.env.*
!*.example.env
!config.example.env

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*

# ── Node.js (no active Node deps — included to prevent accidental commits) ────
node_modules/
package-lock.json
